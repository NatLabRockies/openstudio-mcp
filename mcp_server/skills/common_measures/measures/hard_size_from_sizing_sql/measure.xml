  <class_name>HardSizeFromSizingSql</class_name>
  <display_name>Hard Size From Sizing SQL</display_name>
  <description>Applies sizing results from a sizing-run SQL file to the model and turns sizing off when nothing is left autosized.</description>
  <modeler_description>Attaches the SQL with Model::setSqlFile, calls Model::applySizingValues, counts fields still set to Autosize, and turns zone, system and plant sizing (and sizing-period simulation) off only when that count is zero.</modeler_description>
  <arguments>
    <argument>
      <name>sql_path</name>
      <display_name>Sizing SQL path</display_name>
      <description>eplusout.sql from a sizing run of this same model. An absolute path, or a file name found on the workflow file search path (e.g. the model files/ folder).</description>
      <type>String</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
    </argument>
  </arguments>
