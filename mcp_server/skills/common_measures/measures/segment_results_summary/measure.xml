  <class_name>SegmentResultsSummary</class_name>
  <display_name>Segment Results Summary</display_name>
  <description>Writes segment_results.json with monthly end uses, daily electricity and monthly peak electric demand for the kept days of a time segment.</description>
  <modeler_description>Requests daily end-use meters and timestep Electricity:Facility, reads them from the SQL for the kept dates only (lead-in days dropped), and writes run/segment_results.json for stitch_segment_results.</modeler_description>
  <arguments>
    <argument>
      <name>keep_begin_month</name>
      <display_name>Keep Begin Month</display_name>
      <description>Kept days are reported; days outside them (the lead-in) are dropped.</description>
      <type>Integer</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>1</default_value>
    </argument>
    <argument>
      <name>keep_begin_day</name>
      <display_name>Keep Begin Day</display_name>
      <description>Kept days are reported; days outside them (the lead-in) are dropped.</description>
      <type>Integer</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>1</default_value>
    </argument>
    <argument>
      <name>keep_end_month</name>
      <display_name>Keep End Month</display_name>
      <description>Kept days are reported; days outside them (the lead-in) are dropped.</description>
      <type>Integer</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>12</default_value>
    </argument>
    <argument>
      <name>keep_end_day</name>
      <display_name>Keep End Day</display_name>
      <description>Kept days are reported; days outside them (the lead-in) are dropped.</description>
      <type>Integer</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>31</default_value>
    </argument>
  </arguments>
